# 飞书应用凭证（服务端专用，绝不进前端、绝不上传 GitHub）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格坐标（必填，没有内置默认值）
FEISHU_APP_TOKEN=你的base_token
FEISHU_TABLE_ID=你的table_id

# 服务端口（部署环境会自动注入 PORT，本地可不填）
PORT=3000

# 看板独立认证（至少 16 位随机密码；也可运行 scripts/setup-auth.js）
BOARD_USERNAME=owner
BOARD_PASSWORD=请替换为至少16位随机密码
# 仅在部署到容器或受保护的 HTTPS 网关时设为 0.0.0.0
HOST=127.0.0.1
